---
import Section from './ui/Section.astro';
import { judges, achievements, achievementsLead } from '../data/site';
---

<Section id="achievements" heading="Competitive Programming">
  <p>{achievementsLead}</p>
  <ul class="mt-3 list-disc space-y-1.5 pl-5">
    {
      judges.map((judge) => (
        <li>
          <a href={judge.url} target="_blank" rel="noopener">
            {judge.name}
          </a>{' '}
          — max rating {judge.rating}, {judge.detail}
        </li>
      ))
    }
  </ul>
  <h3 class="mt-6 font-semibold">Contests</h3>
  <ul class="mt-2 list-disc space-y-1.5 pl-5">
    {
      achievements.map((item) => (
        <li>
          {item.placement} — {item.title}
          {item.year && <span class="text-muted"> ({item.year})</span>}
        </li>
      ))
    }
  </ul>
</Section>
