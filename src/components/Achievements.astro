---
import Section from './ui/Section.astro';
import { achievements } from '../data/site';
---

<Section id="achievements" heading="Competitive Programming" index="05">
  <p class="mb-8 max-w-prose leading-relaxed text-muted">{achievements.lead}</p>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      achievements.judges.map((judge) => (
        <a
          href={judge.url}
          target="_blank"
          rel="noopener"
          class="rounded-lg border border-border bg-surface p-5 transition duration-200 hover:-translate-y-0.5 hover:border-accent/40"
        >
          <p class="mb-1 font-mono text-xs text-faint">{judge.name}</p>
          <p class="mb-1 text-2xl font-semibold text-body">{judge.stat}</p>
          <p class="text-sm text-accent">{judge.detail}</p>
        </a>
      ))
    }
  </div>
  <p class="mt-8 text-sm text-muted">{achievements.highlights}</p>
</Section>
