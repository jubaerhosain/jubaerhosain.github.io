---
import { site, nav } from '../data/site';
import Icon from './ui/Icon.astro';
---

<header
  class="fixed inset-x-0 top-0 z-40 flex h-15 items-center justify-between border-b border-border bg-sidebar px-5 lg:hidden"
>
  <a href="#intro" class="min-w-0">
    <span class="block truncate text-sm font-bold text-text">{site.name}</span>
    <span class="block truncate font-mono text-[0.7rem] text-primary">{site.title}</span>
  </a>

  <div class="flex flex-shrink-0 items-center gap-1">
    <a
      href={site.resume}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Download CV"
      class="p-2 text-text-light transition hover:text-primary"
    >
      <Icon name="download" class="h-5 w-5" />
    </a>
    <button
      type="button"
      id="menu-open"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="p-2 text-text-light transition hover:text-primary"
    >
      <Icon name="menu" class="h-6 w-6" />
    </button>
  </div>
</header>

<div
  id="mobile-menu"
  class="invisible fixed inset-0 z-50 opacity-0 transition-opacity duration-300 lg:hidden"
  aria-hidden="true"
>
  <div id="menu-overlay" class="absolute inset-0 bg-black/50"></div>

  <div
    id="menu-panel"
    role="dialog"
    aria-modal="true"
    aria-label="Navigation menu"
    class="absolute inset-y-0 right-0 flex w-70 max-w-[85vw] translate-x-full flex-col border-l border-border bg-sidebar transition-transform duration-300"
  >
    <div class="flex items-center justify-end border-b border-border px-5 py-3">
      <button
        type="button"
        id="menu-close"
        aria-label="Close menu"
        class="p-2 text-text-light transition hover:text-primary"
      >
        <Icon name="close" class="h-6 w-6" />
      </button>
    </div>

    <nav aria-label="Sections" class="flex-1 overflow-y-auto px-5 py-8">
      <ul class="flex flex-col gap-4">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                data-nav-link={item.id}
                data-menu-dismiss
                class="block border-l-2 border-transparent pl-4 font-mono text-sm text-text-light transition hover:border-primary hover:text-primary aria-[current=true]:border-primary aria-[current=true]:text-primary"
              >
                # {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-4 border-t border-border px-5 py-6">
      <a
        href={site.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="text-text-lighter transition hover:text-primary"
      >
        <Icon name="github" class="h-5 w-5" />
      </a>
      <a
        href={site.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class="text-text-lighter transition hover:text-primary"
      >
        <Icon name="linkedin" class="h-5 w-5" />
      </a>
      <a
        href={`mailto:${site.email}`}
        aria-label="Email"
        class="text-text-lighter transition hover:text-primary"
      >
        <Icon name="mail" class="h-5 w-5" />
      </a>
    </div>
  </div>
</div>
