---
import Section from './ui/Section.astro';
import { experience } from '../data/site';
---

<Section id="experience" heading="Experience" index="02">
  <div class="border-l-2 border-accent pl-6">
    <div class="mb-1 flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <h3 class="text-lg font-semibold text-body">{experience.title}</h3>
      <span class="text-muted">·</span>
      <a
        href={experience.companyUrl}
        target="_blank"
        rel="noopener"
        class="text-accent hover:underline">{experience.company}</a
      >
    </div>
    <p class="mb-4 font-mono text-sm text-faint">
      {experience.period} · {experience.location}
    </p>
    <p class="mb-2 max-w-prose leading-relaxed text-muted">
      {experience.intro}
      <a
        href={experience.introLink.url}
        target="_blank"
        rel="noopener"
        class="text-accent hover:underline">{experience.introLink.label}</a
      >
    </p>
    <div class="mb-5 flex flex-wrap gap-2">
      {
        experience.stack.map((tech) => (
          <span class="rounded-full bg-accent/10 px-2.5 py-0.5 font-mono text-xs text-accent">
            {tech}
          </span>
        ))
      }
    </div>
    <ul class="max-w-prose space-y-3">
      {
        experience.bullets.map((bullet) => (
          <li class="flex gap-3 leading-relaxed text-muted">
            <span class="mt-0.5 shrink-0 text-accent">▸</span>
            <span>{bullet}</span>
          </li>
        ))
      }
    </ul>
    <p class="mt-8 text-sm text-faint">
      {experience.education.degree} — {experience.education.school}
    </p>
  </div>
</Section>
