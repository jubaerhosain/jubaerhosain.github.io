---
import Section from './ui/Section.astro';
import { experience } from '../data/site';
---

<Section id="experience" heading="Experience">
  <div class="space-y-8">
    {
      experience.map((job) => (
        <div>
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h3 class="font-semibold">
              {job.title} —{' '}
              {job.companyUrl ? (
                <a href={job.companyUrl} target="_blank" rel="noopener">
                  {job.company}
                </a>
              ) : (
                job.company
              )}
            </h3>
            <span class="text-sm text-muted">{job.period}</span>
          </div>
          {job.intro && (
            <p class="mt-2">
              {job.intro}
              {job.introLink && (
                <>
                  {' '}
                  <a href={job.introLink.url} target="_blank" rel="noopener">
                    {job.introLink.label}
                  </a>
                </>
              )}
            </p>
          )}
          {job.stack && (
            <p class="mt-1 text-sm text-muted">Stack: {job.stack.join(', ')}</p>
          )}
          <ul class="mt-3 list-disc space-y-1.5 pl-5">
            {job.bullets.map((bullet) => (
              <li>{bullet}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>
