---
import { site } from '../data/site';
import Icon from './ui/Icon.astro';
---

<section class="mx-auto flex max-w-4xl flex-col-reverse items-start gap-10 px-6 pt-20 pb-24 md:flex-row md:items-center md:justify-between md:pt-28 md:pb-28">
  <div class="max-w-xl">
    <p class="mb-3 font-mono text-sm text-accent">{site.role}</p>
    <h1 class="mb-5 text-4xl font-bold tracking-tight text-body md:text-5xl">{site.name}</h1>
    <p class="mb-8 leading-relaxed text-muted">{site.tagline}</p>
    <div class="mb-8 flex flex-wrap gap-4">
      <a
        href="#projects"
        class="rounded-md bg-accent px-5 py-2.5 font-medium text-slate-900 transition-colors duration-200 hover:bg-accent-bright"
      >
        View Projects
      </a>
      <a
        href={site.resume}
        target="_blank"
        class="flex items-center gap-2 rounded-md border border-accent px-5 py-2.5 font-medium text-accent transition-colors duration-200 hover:bg-accent/10"
      >
        <Icon name="arrow-down" class="h-4 w-4" />
        Download Resume
      </a>
    </div>
    <div class="flex items-center gap-5">
      <a href={site.github} target="_blank" rel="noopener" aria-label="GitHub" class="text-faint transition-colors duration-200 hover:text-accent">
        <Icon name="github" />
      </a>
      <a href={site.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" class="text-faint transition-colors duration-200 hover:text-accent">
        <Icon name="linkedin" />
      </a>
      <a href={`mailto:${site.email}`} aria-label="Email" class="text-faint transition-colors duration-200 hover:text-accent">
        <Icon name="mail" />
      </a>
    </div>
  </div>
  <img
    src="/images/profile.jpg"
    alt={site.name}
    width="208"
    height="208"
    class="h-40 w-40 rounded-2xl object-cover ring-1 ring-accent/60 md:h-52 md:w-52"
  />
</section>
