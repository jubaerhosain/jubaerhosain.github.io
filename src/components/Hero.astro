---
import { site } from '../data/site';
---

<section class="mt-10 flex items-start justify-between gap-6">
  <div>
    <h1 class="text-3xl font-bold tracking-tight">{site.name}</h1>
    <p class="mt-1 text-muted">{site.role} — {site.location}</p>
    <p class="mt-4">{site.tagline}</p>
    <p class="mt-4 text-sm">
      <a href={site.github} target="_blank" rel="noopener">GitHub</a>
      <span class="text-muted"> · </span>
      <a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <span class="text-muted"> · </span>
      <a href={`mailto:${site.email}`}>Email</a>
      <span class="text-muted"> · </span>
      <a href={site.resume} target="_blank">Resume (PDF)</a>
    </p>
  </div>
  <img
    src="/images/profile.jpg"
    alt={site.name}
    width="112"
    height="112"
    class="hidden h-28 w-28 shrink-0 rounded object-cover sm:block"
  />
</section>
