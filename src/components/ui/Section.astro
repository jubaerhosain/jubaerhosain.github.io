---
/** Numbered section wrapper — `01.` in mono + title, matching the reference. */
interface Props {
  id: string;
  number: string;
  title: string;
  last?: boolean;
}

const { id, number, title, last = false } = Astro.props;
---

<section id={id} class={last ? '' : 'mb-12 pb-12'}>
  <div class="mb-8 flex items-center gap-4">
    <span class="font-mono text-xl font-bold text-primary">{number}.</span>
    <h2 class="text-2xl font-bold tracking-tight text-text sm:text-[1.75rem]">{title}</h2>
  </div>
  <slot />
</section>
