---
import { experience, education } from '../../data/site';
import Section from '../ui/Section.astro';
import AccentCard from '../ui/AccentCard.astro';
import Tag from '../ui/Tag.astro';
---

<Section id="work" number="02" title="Work Experience">
  {
    experience.map((job) => (
      <article>
        <header class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
          <h3 class="text-lg font-semibold text-text">
            {job.companyUrl ? (
              <a
                href={job.companyUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="transition hover:text-primary"
              >
                {job.company}
              </a>
            ) : (
              job.company
            )}
          </h3>
          <p class="font-mono text-xs whitespace-nowrap text-text-lighter">
            {job.period}
            {job.location && ` · ${job.location}`}
          </p>
        </header>

        {job.intro && (
          <p class="mt-2 text-text-light">
            {job.intro}{' '}
            {job.introLink && (
              <a
                href={job.introLink.url}
                target="_blank"
                rel="noopener noreferrer"
                class="font-mono text-xs text-primary underline underline-offset-2"
              >
                {job.introLink.label}
              </a>
            )}
          </p>
        )}

        {job.stack && (
          <div class="mt-4 flex flex-wrap gap-2">
            {job.stack.map((item) => (
              <Tag tone="primary">{item}</Tag>
            ))}
          </div>
        )}

        {/* Role bands on a shared timeline rail, most recent first. */}
        <ol class="relative mt-8 pl-8 before:absolute before:top-2 before:bottom-2 before:left-0 before:w-0.5 before:bg-border before:content-['']">
          {job.roles.map((role) => (
            <li class="relative mb-8 last:mb-0">
              <span
                class="absolute top-1.5 left-[-2.3125rem] h-3 w-3 rounded-full bg-primary"
                aria-hidden="true"
              />
              <div class="flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
                <h4 class="font-semibold text-text">{role.title}</h4>
                <p class="font-mono text-xs whitespace-nowrap text-text-lighter">{role.period}</p>
              </div>
              <ul class="mt-3 space-y-2">
                {role.bullets.map((bullet) => (
                  <li class="relative pl-5 text-text-light before:absolute before:top-[0.6em] before:left-0 before:h-1.5 before:w-1.5 before:rounded-full before:bg-primary before:content-['']">
                    <span set:html={bullet} />
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
      </article>
    ))
  }

  <div class="mt-12">
    <h3 class="mb-6 text-xl font-semibold text-text">Education</h3>
    <ul class="space-y-6">
      {
        education.map((entry) => (
          <AccentCard as="li">
            <div class="flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
              <h4 class="font-semibold text-text">{entry.degree}</h4>
              {entry.period && (
                <p class="font-mono text-xs whitespace-nowrap text-text-lighter">{entry.period}</p>
              )}
            </div>
            <p class="mt-1 text-sm text-text-light">
              {entry.school}
              {entry.note && <span class="text-text-lighter"> · {entry.note}</span>}
            </p>
          </AccentCard>
        ))
      }
    </ul>
  </div>
</Section>
