---
import { experience } from '../../data/site';
import Section from '../ui/Section.astro';
import Tag from '../ui/Tag.astro';
---

<Section id="experience" title="Experience">
  {
    experience.map((job) => (
      <article>
        <header class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
          <h3 class="text-lg font-semibold text-text">
            {job.companyUrl ? (
              <a
                href={job.companyUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="transition hover:text-primary"
              >
                {job.company}
              </a>
            ) : (
              job.company
            )}
            {job.location && (
              <span class="font-normal text-text-lighter"> · {job.location}</span>
            )}
          </h3>
          <p class="font-mono text-xs whitespace-nowrap text-text-lighter">{job.period}</p>
        </header>

        {job.intro && (
          <p class="mt-2 text-text-light">
            {job.intro}{' '}
            {job.introLink && (
              <a
                href={job.introLink.url}
                target="_blank"
                rel="noopener noreferrer"
                class="font-mono text-xs text-primary underline underline-offset-2"
              >
                {job.introLink.label}
              </a>
            )}
          </p>
        )}

        {job.stack && (
          <div class="mt-4 flex flex-wrap gap-2">
            {job.stack.map((item) => (
              <Tag tone="primary">{item}</Tag>
            ))}
          </div>
        )}

        {/* Role bands on a shared timeline rail, most recent first. */}
        <ol class="relative mt-8 pl-8 before:absolute before:top-2 before:bottom-2 before:left-0 before:w-0.5 before:bg-border before:content-['']">
          {job.roles.map((role) => (
            <li class="relative mb-8 last:mb-0">
              <span
                class="absolute top-1.5 left-[-2.3125rem] h-3 w-3 rounded-full bg-primary"
                aria-hidden="true"
              />
              <div class="flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
                <h4 class="font-semibold text-text">{role.title}</h4>
                <p class="font-mono text-xs whitespace-nowrap text-text-lighter">{role.period}</p>
              </div>
              <ul class="mt-3 space-y-2">
                {role.bullets.map((bullet) => (
                  <li class="relative pl-5 text-text-light before:absolute before:top-[0.6em] before:left-0 before:h-1.5 before:w-1.5 before:rounded-full before:bg-primary before:content-['']">
                    <span set:html={bullet} />
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
      </article>
    ))
  }
</Section>
