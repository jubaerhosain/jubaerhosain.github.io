---
import { site, nav } from '../data/site';
import Icon from './ui/Icon.astro';
---

<aside
  class="sticky top-0 hidden h-screen flex-col overflow-y-auto border-r border-border bg-sidebar lg:flex"
>
  <div class="flex flex-1 flex-col gap-12 px-8 pt-12 pb-8">
    <div class="border-b border-border pb-8">
      <a href="#intro" class="group block">
        <h1
          class="text-2xl leading-tight font-bold tracking-tight text-text transition group-hover:text-primary"
        >
          {site.name}
        </h1>
      </a>
      <p class="mt-2 font-mono text-xs leading-snug text-primary">{site.title}</p>
      <p class="mt-1.5 text-sm text-text-light">{site.company}</p>
      <p class="text-sm text-text-lighter">{site.location}</p>
    </div>

    <nav aria-label="Sections">
      <ul class="flex flex-col gap-4">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                data-nav-link={item.id}
                class="block border-l-2 border-transparent pl-4 font-mono text-sm text-text-light transition hover:border-primary hover:text-primary aria-[current=true]:border-primary aria-[current=true]:text-primary"
              >
                # {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="sticky bottom-0 mt-auto border-t border-border bg-sidebar px-8 py-8">
    <div class="flex items-center gap-4">
      <a
        href={site.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="text-text-lighter transition hover:text-primary"
      >
        <Icon name="github" class="h-5 w-5" />
      </a>
      <a
        href={site.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class="text-text-lighter transition hover:text-primary"
      >
        <Icon name="linkedin" class="h-5 w-5" />
      </a>
      <a
        href={`mailto:${site.email}`}
        aria-label="Email"
        class="text-text-lighter transition hover:text-primary"
      >
        <Icon name="mail" class="h-5 w-5" />
      </a>
    </div>

    <a
      href={site.resume}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-4 flex w-full items-center justify-center gap-2 rounded border border-primary bg-primary px-4 py-2 font-mono text-xs text-white transition hover:bg-primary-dark"
    >
      <Icon name="download" class="h-4 w-4" />
      Download CV
    </a>
  </div>
</aside>
