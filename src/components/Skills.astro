---
import Section from './ui/Section.astro';
import { skills } from '../data/site';
---

<Section id="skills" heading="Skills">
  <dl class="space-y-2">
    {
      skills.map((row) => (
        <div class="sm:flex sm:gap-3">
          <dt class="shrink-0 font-semibold sm:w-40">{row.label}</dt>
          <dd class="text-muted">{row.items.join(', ')}</dd>
        </div>
      ))
    }
  </dl>
</Section>
